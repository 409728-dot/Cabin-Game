    <script>
      const lines = [
        "It started three weeks ago.",
        "First, it was the Miller boy. Then the twins from down the creek.",
        "The police combed the woods. They found nothing.",
        "But we knew better. Kids don't just 'wander off' around here.",
        "Dylan found an old map. Kevin swiped heavy flashlights.",
        "Jayden didn't want to come. He kept talking about the local legends...",
        "And me? I'm Vickram. I just wanted to know the truth.",
        "We went to investigate why the little kids were disappearing.",
        "...We should have just stayed home.",
        "We also learned that he watches, and strikes if we don't leave."
      ];

      let currentLine = 0;
      let fadeTimeout, nextLineTimeout;

      function playIntro() {
        const textElement = document.getElementById("dialogue-text");
        if (!window.introActive || !textElement) return;

        if (currentLine < lines.length) {
          textElement.innerText = lines[currentLine];
          void textElement.offsetWidth; 
          textElement.style.opacity = "1";
          
          fadeTimeout = setTimeout(() => {
            if (!window.introActive) return;
            textElement.style.opacity = "0";
            currentLine++;
            nextLineTimeout = setTimeout(playIntro, 2000); 
          }, 3500); 
        } else {
          endIntro(3000); 
        }
      }

      function endIntro(fadeDuration) {
        const overlay = document.getElementById("intro-overlay");
        if (!window.introActive || !overlay) return;
        
        window.introActive = false;
        overlay.style.transition = `opacity ${fadeDuration / 1000}s ease-in-out`;
        overlay.style.opacity = "0";
        
        setTimeout(() => {
          overlay.style.display = "none";
        }, fadeDuration);
      }

      window.addEventListener('DOMContentLoaded', () => {
        window.addEventListener('keydown', (event) => {
          if (event.code === 'Space' && window.introActive) {
            clearTimeout(fadeTimeout);
            clearTimeout(nextLineTimeout);
            endIntro(1000); 
          }
        });

        setTimeout(playIntro, 1500); 
      });
    </script>
